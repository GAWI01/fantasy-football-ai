# Backend-only context: deny by default, then allow serving code and artifacts.
# The frontend Docker build uses frontend/.dockerignore in its own context.
**
!backend/*.py
!backend/runtime-requirements.txt
!optimizer/*.py
!engine/*.py
!historical_data/current_data/players_current.csv
!historical_data/current_data/players_raw.csv
!historical_data/current_data/teams_current.csv
!historical_data/current_data/fixtures_current.csv
!historical_data/current_data/gameweeks_current.csv
!historical_data/current_data/manifest.json
!historical_data/current_data/gw*_predictions_v*.csv
!historical_data/current_data/gw*_predictions_v*.csv.manifest.json

# Defense in depth: never send local secrets or caches, even after allowlist edits.
**/.env
**/.env.*
**/secrets/**
**/credentials*
**/*.pem
**/*.key
**/.git/**
**/.venv/**
**/venv/**
**/__pycache__/**
**/.pytest_cache/**
**/node_modules/**
**/.next/**
**/*.pyc
