# Safe LOCAL examples only. Never place credentials in NEXT_PUBLIC_* variables.
# Vercel build: use the browser-reachable HTTPS Railway origin (no /api).
# Example shape: https://YOUR-API.up.railway.app; changing it requires a rebuild.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Comma-separated, explicit frontend origins accepted by the API.
# Railway runtime: use exact HTTPS Vercel/custom origins, no paths or wildcard.
FPL_AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend container listener; Railway may supply PORT. Local Compose uses 8000.
PORT=8000

# Railway build setting for this repository's non-default Dockerfile name.
RAILWAY_DOCKERFILE_PATH=Dockerfile.backend
